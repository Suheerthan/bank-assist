# Copy this file to .env and fill in what you use.

# none = offline rules + templates (works without internet)
# gemini or anthropic = AI model writes intent rationale, drafts and summaries
LLM_PROVIDER=none

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# used in order if the main model is busy (503)
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash-lite

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

LLM_TIMEOUT_SECONDS=12
# after all models fail, use offline mode for this many seconds, then retry
LLM_COOLDOWN_SECONDS=60

# MongoDB is used if it is running; otherwise data/local_store.json is used
MONGO_URI=mongodb://localhost:27017
MONGO_DB=bank_assist
